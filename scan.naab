# ╔══════════════════════════════════════════════════════════════════╗
# ║  NAAb BOLO — scan.naab                                         ║
# ║  Static Analysis Scanner — NAAb + C++ (via bolo stdlib)         ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# WHY C++:  bolo.scan() calls the C++ GovernanceEngine internally.
#           std::regex compiles patterns once, scans at native speed.
#           50x faster than Python re module for bulk pattern matching.
# WHY SHELL: find for portable file discovery.
# WHY NAAB: Orchestrates scanning, formats output, manages state.

main {
    let args = env.get_args()
    let argc = array.length(args)

    if argc < 1 {
        print("Usage: naab-lang scan.naab <path> [--profile <name>] [--format json|text]")
        return
    }

    let target_path = args[0]
    let profile = "enterprise"
    let format = "text"

    # Parse options
    let i = 1
    while i < argc {
        if args[i] == "--profile" {
            if i + 1 < argc { i = i + 1; profile = args[i] }
        } else if args[i] == "--format" {
            if i + 1 < argc { i = i + 1; format = args[i] }
        }
        i = i + 1
    }

    # Load the bolo profile
    bolo.load_profile(profile)

    # ═══════════════════════════════════════════════════════════════
    # PHASE 1: Discover files (Shell — simple find for portability)
    # ═══════════════════════════════════════════════════════════════
    let file_listing = <<shell[target_path]
        find "$target_path" -type f \( \
            -name "*.py" -o -name "*.js" -o -name "*.ts" -o \
            -name "*.go" -o -name "*.rs" -o -name "*.cpp" -o \
            -name "*.java" -o -name "*.rb" -o -name "*.php" -o \
            -name "*.sh" -o -name "*.bash" -o -name "*.cs" -o \
            -name "*.c" -o -name "*.h" \
        \) 2>/dev/null | sort
    >>

    let files = string.split(string.trim(file_listing), "\n")
    let file_count = array.length(files)

    if file_count == 0 {
        print("No source files found in: " + target_path)
        return
    }

    print("NAAb BOLO Scanner [" + profile + "]")
    print("Scanning " + "" + file_count + " files in " + target_path)
    print("")

    # ═══════════════════════════════════════════════════════════════
    # PHASE 2: C++ Pattern Matching Engine
    # WHY C++: std::regex compiles patterns ONCE, then matches in
    #          microseconds per file. For 50+ regex patterns across
    #          thousands of files, C++ is 50x faster than Python.
    # ═══════════════════════════════════════════════════════════════

    let all_violations = []
    let files_with_issues = 0

    for filepath in files {
        if string.length(filepath) == 0 { continue }

        # Detect language
        let parts = string.split(filepath, ".")
        let ext = ""
        if array.length(parts) > 1 {
            ext = parts[array.length(parts) - 1]
        }
        let lang = "unknown"
        if ext == "py" { lang = "python" }
        if ext == "js" { lang = "javascript" }
        if ext == "ts" { lang = "typescript" }
        if ext == "go" { lang = "go" }
        if ext == "rs" { lang = "rust" }
        if ext == "cpp" { lang = "cpp" }
        if ext == "cc" { lang = "cpp" }
        if ext == "c" { lang = "c" }
        if ext == "h" { lang = "cpp" }
        if ext == "java" { lang = "java" }
        if ext == "rb" { lang = "ruby" }
        if ext == "php" { lang = "php" }
        if ext == "sh" { lang = "shell" }
        if ext == "bash" { lang = "shell" }
        if ext == "cs" { lang = "csharp" }
        if lang == "unknown" { continue }

        try {
            let code = file.read(filepath)

            # Run C++ governance engine via bolo stdlib
            # This calls checkPolyglotBlock() which runs ALL 50+ checks:
            # - LLM anti-drift (3): oversimplification, incomplete logic, hallucinated APIs
            # - Code quality (17): secrets, PII, placeholders, dead code, etc.
            # - Security (7): injection, escalation, exfiltration, etc.
            # - Per-language (4): imports, banned functions, style, size
            let violations = bolo.scan(lang, code)

            if array.length(violations) > 0 {
                files_with_issues = files_with_issues + 1

                for v in violations {
                    # Add file path to violation
                    let enriched = {
                        "file": filepath,
                        "line": v.line,
                        "rule": v.rule,
                        "message": v.message,
                        "severity": v.severity,
                        "category": v.category,
                        "level": v.level
                    }
                    all_violations.push(enriched)

                    if format == "text" {
                        let icon = "!"
                        if v.severity == "critical" { icon = "X" }
                        if v.severity == "high" { icon = "X" }
                        print("  " + icon + " " + filepath + ":" + "" + v.line + " " + v.rule)
                        print("    " + v.message)
                        print("")
                    }
                }
            }
        } catch (e) {
            # Skip unreadable files
        }
    }

    # ═══════════════════════════════════════════════════════════════
    # PHASE 3: Output Results
    # ═══════════════════════════════════════════════════════════════

    let total = array.length(all_violations)

    if format == "json" {
        # JSON output via Python — best for structured data serialization
        # WHY PYTHON: json.dumps handles escaping, unicode, nested structures
        let json_output = <<python[all_violations] -> JSON
import json
violations = json.loads(all_violations) if isinstance(all_violations, str) else all_violations
output = {
    "tool": "naab-bolo",
    "version": "1.0.0",
    "total_violations": len(violations),
    "violations": violations
}
naab_return(json.dumps(output, indent=2))
        >>
        print(json_output)
    } else {
        # Text summary
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        print("Files scanned:    " + "" + file_count)
        print("Files with issues:" + "" + files_with_issues)
        print("Total violations: " + "" + total)
        if total == 0 {
            print("")
            print("All clear! No issues found.")
        }
    }
}
