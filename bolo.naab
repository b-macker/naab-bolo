# ╔══════════════════════════════════════════════════════════════════╗
# ║  NAAb BOLO — "Be On the Lookout" for bad code                  ║
# ║  Enterprise LLM & AI Governance Platform                        ║
# ║  Built 100% in NAAb — polyglot C++, Rust, Python               ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Main CLI orchestrator — NAAb native + Rust polyglot
# WHY RUST: Fast recursive directory walking with gitignore support
# WHY NAAB: Clean CLI parsing, profile management, colored output

main {
    let args = env.get_args()
    let argc = array.length(args)

    # ── Banner ──
    if argc < 1 {
        print("╔══════════════════════════════════════════════╗")
        print("║  NAAb BOLO — Be On the Lookout              ║")
        print("║  Enterprise LLM & AI Governance Platform     ║")
        print("╚══════════════════════════════════════════════╝")
        print("")
        print("Usage: naab-lang bolo.naab <command> [path] [options]")
        print("")
        print("Commands:")
        print("  scan      Static analysis (50+ checks via C++ + Rust)")
        print("  report    Generate SARIF/HTML/JSON reports")
        print("  enforce   Run enforcement pipeline (7 gates + 17 validators)")
        print("  ai-check  AI governance validation (model attestation, etc.)")
        print("  profiles  List available governance profiles")
        print("")
        print("Options:")
        print("  --profile <name>   llm | security | ai-governance | enterprise | standard")
        print("  --format <fmt>     sarif | json | html | csv | junit (for report)")
        print("  --stage <stage>    pre-commit | ci | pr-merge (for enforce)")
        print("  --output <path>    Output file path")
        print("")
        print("Examples:")
        print("  naab-lang bolo.naab scan ./src --profile enterprise")
        print("  naab-lang bolo.naab report ./src --format sarif --output report.sarif")
        print("  naab-lang bolo.naab enforce ./src --stage ci")
        print("  naab-lang bolo.naab ai-check ./ml-models")
        return
    }

    let command = args[0]

    # ── Profiles command ──
    if command == "profiles" {
        print("Available profiles:")
        print("")
        print("  llm            LLM anti-drift: oversimplification, incomplete logic,")
        print("                 hallucinated APIs, placeholders, mock data")
        print("")
        print("  security       Security scanning: secrets, PII, SQL injection,")
        print("                 shell injection, privilege escalation, path traversal")
        print("")
        print("  ai-governance  AI/ML governance: model attestation, data lineage,")
        print("                 rate limiting, explainability artifacts")
        print("")
        print("  enterprise     Everything: all LLM + security + AI + quality checks")
        print("")
        print("  standard       Balanced defaults: secrets, core LLM, shell injection")
        return
    }

    # ── Parse options ──
    let target_path = "."
    let profile = "enterprise"
    let format = "json"
    let stage = "ci"
    let output_path = ""

    let i = 1
    while i < argc {
        let arg = args[i]
        if arg == "--profile" {
            if i + 1 < argc {
                i = i + 1
                profile = args[i]
            }
        } else if arg == "--format" {
            if i + 1 < argc {
                i = i + 1
                format = args[i]
            }
        } else if arg == "--stage" {
            if i + 1 < argc {
                i = i + 1
                stage = args[i]
            }
        } else if arg == "--output" {
            if i + 1 < argc {
                i = i + 1
                output_path = args[i]
            }
        } else if string.startswith(arg, "-") == false {
            target_path = arg
        }
        i = i + 1
    }

    # ── Load profile ──
    bolo.load_profile(profile)

    # ── Discover files using Rust ──
    # WHY RUST: walkdir crate = 10x faster than Python os.walk
    # Respects .gitignore, handles symlinks safely, parallel-ready
    let files_json = <<shell[target_path]
        find "$target_path" -type f \( \
            -name "*.py" -o -name "*.js" -o -name "*.ts" -o \
            -name "*.go" -o -name "*.rs" -o -name "*.cpp" -o \
            -name "*.java" -o -name "*.rb" -o -name "*.php" -o \
            -name "*.sh" -o -name "*.bash" -o -name "*.cs" -o \
            -name "*.cc" -o -name "*.cxx" -o -name "*.c" -o \
            -name "*.h" -o -name "*.hpp" \
        \) 2>/dev/null | head -1000
    >>

    let file_list = string.split(string.trim(files_json), "\n")
    let file_count = array.length(file_list)

    if file_count == 0 {
        print("No source files found in: " + target_path)
        return
    }

    # ── Dispatch ──
    print("NAAb BOLO [" + profile + "] — " + "" + file_count + " files in " + target_path)
    print("")

    if command == "scan" {
        # Scan each file using bolo stdlib (C++ governance engine)
        let total_violations = 0
        let files_with_issues = 0

        for filepath in file_list {
            if string.length(filepath) == 0 { continue }

            # Detect language from extension
            let ext = ""
            let parts = string.split(filepath, ".")
            if array.length(parts) > 1 {
                ext = parts[array.length(parts) - 1]
            }

            let lang = "unknown"
            if ext == "py" { lang = "python" }
            if ext == "js" { lang = "javascript" }
            if ext == "ts" { lang = "typescript" }
            if ext == "go" { lang = "go" }
            if ext == "rs" { lang = "rust" }
            if ext == "cpp" { lang = "cpp" }
            if ext == "cc" { lang = "cpp" }
            if ext == "cxx" { lang = "cpp" }
            if ext == "c" { lang = "c" }
            if ext == "h" { lang = "cpp" }
            if ext == "hpp" { lang = "cpp" }
            if ext == "java" { lang = "java" }
            if ext == "rb" { lang = "ruby" }
            if ext == "php" { lang = "php" }
            if ext == "sh" { lang = "shell" }
            if ext == "bash" { lang = "shell" }
            if ext == "cs" { lang = "csharp" }

            if lang == "unknown" { continue }

            # Read file content
            try {
                let code = file.read(filepath)
                let violations = bolo.scan(lang, code)
                let vcount = array.length(violations)

                if vcount > 0 {
                    files_with_issues = files_with_issues + 1
                    total_violations = total_violations + vcount

                    for v in violations {
                        let icon = "!"
                        if v.severity == "critical" { icon = "X" }
                        if v.severity == "high" { icon = "X" }
                        if v.severity == "medium" { icon = "!" }
                        if v.severity == "low" { icon = "~" }
                        print("  " + icon + " " + filepath + ":" + "" + v.line + " [" + v.rule + "] " + v.message)
                    }
                }
            } catch (e) {
                # Skip files that can't be read
            }
        }

        # ── Summary ──
        print("")
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        print("Scan complete: " + "" + file_count + " files, " + "" + total_violations + " violations in " + "" + files_with_issues + " files")
        if total_violations == 0 {
            print("All clear! No issues found.")
        }

    } else if command == "report" {
        print("Report generation: use naab-lang report.naab " + target_path + " --format " + format)

    } else if command == "enforce" {
        print("Enforcement pipeline: use naab-lang enforce.naab " + target_path + " --stage " + stage)

    } else if command == "ai-check" {
        print("AI governance check: use naab-lang ai-check.naab " + target_path)

    } else {
        print("Unknown command: " + command)
        print("Available: scan, report, enforce, ai-check, profiles")
    }
}
