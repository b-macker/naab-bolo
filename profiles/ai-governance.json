{
  "name": "ai-governance",
  "description": "AI/ML governance: model attestation, data lineage, rate limiting, explainability",
  "checks": {
    "llm_anti_drift": {
      "oversimplification": true,
      "incomplete_logic": true,
      "hallucinated_apis": true
    },
    "code_quality": {
      "no_secrets": true,
      "no_placeholders": true,
      "no_mock_data": true
    },
    "ai_governance": {
      "governance_config": true,
      "model_attestation": true,
      "rate_limiting": true,
      "explainability": true
    }
  },
  "thresholds": {
    "max_critical_violations": 0,
    "max_high_violations": 3
  }
}
