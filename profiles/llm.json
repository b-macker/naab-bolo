{
  "name": "llm",
  "description": "LLM anti-drift: oversimplification, incomplete logic, hallucinated APIs, placeholders, mock data",
  "checks": {
    "llm_anti_drift": {
      "oversimplification": true,
      "incomplete_logic": true,
      "hallucinated_apis": true
    },
    "code_quality": {
      "no_placeholders": true,
      "no_mock_data": true,
      "no_apologetic_language": true,
      "no_hardcoded_success": true,
      "no_code_blocks_in_comments": true
    },
    "security": {
      "no_secrets": true
    }
  },
  "thresholds": {
    "max_critical_violations": 0,
    "max_high_violations": 10
  }
}
