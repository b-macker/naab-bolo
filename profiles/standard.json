{
  "name": "standard",
  "description": "Balanced defaults: secrets, core LLM anti-drift, shell injection",
  "checks": {
    "llm_anti_drift": {
      "oversimplification": true,
      "hallucinated_apis": true
    },
    "code_quality": {
      "no_secrets": true,
      "no_placeholders": true,
      "no_debug_code": true
    },
    "security": {
      "no_sql_injection": true,
      "no_shell_injection": true
    }
  },
  "thresholds": {
    "max_critical_violations": 0,
    "max_high_violations": 10
  }
}
