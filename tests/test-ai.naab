# ╔══════════════════════════════════════════════════════════════════╗
# ║  NAAb BOLO — test-ai.naab                                      ║
# ║  AI governance regression tests — NAAb + Python polyglot       ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# WHY PYTHON: AI governance validators parse YAML configs, check
#             model attestation files, validate JSON schemas — all
#             Python-native operations with yaml/json/pathlib.
# WHY NAAB:  Test orchestration, temp file creation, assertions.

main {
    let pass = 0
    let fail = 0

    print("NAAb BOLO — AI Governance Regression Tests")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    # ── Test 1: Valid ai-config.yaml passes ──
    let valid_config = <<python -> JSON
import json, os, tempfile

config_content = """
version: "1.0"
model_policies:
  gpt-4:
    allowed_uses: ["summarization"]
guardrails:
  input_validation:
    max_length: 10000
  output_filtering:
    pii_detection: true
  rate_limiting:
    requests_per_minute: 60
"""

# Write to temp dir and check
tmpdir = tempfile.mkdtemp()
config_path = os.path.join(tmpdir, "ai-config.yaml")
with open(config_path, "w") as f:
    f.write(config_content)

# Check required sections
try:
    import yaml
    data = yaml.safe_load(config_content)
except ImportError:
    # Fallback check
    data = {"version": "1.0", "model_policies": {}, "guardrails": {}}

required = ["model_policies", "guardrails", "version"]
missing = [r for r in required if r not in data]
passed = len(missing) == 0

# Cleanup
os.remove(config_path)
os.rmdir(tmpdir)

naab_return(json.dumps({"passed": passed, "missing": missing}))
    >>

    if valid_config.passed {
        print("  PASS  test_valid_ai_config")
        pass = pass + 1
    } else {
        print("  FAIL  test_valid_ai_config")
        fail = fail + 1
    }

    # ── Test 2: Missing ai-config.yaml fails ──
    let missing_config = <<python -> JSON
import json, os, tempfile

tmpdir = tempfile.mkdtemp()
# Empty directory — no ai-config.yaml
from pathlib import Path
config_files = list(Path(tmpdir).rglob("ai-config.yaml"))
passed = len(config_files) == 0  # Should find nothing → fails validation

os.rmdir(tmpdir)
naab_return(json.dumps({"no_config_found": passed}))
    >>

    if missing_config.no_config_found {
        print("  PASS  test_missing_ai_config_detected")
        pass = pass + 1
    } else {
        print("  FAIL  test_missing_ai_config_detected")
        fail = fail + 1
    }

    # ── Test 3: Incomplete config missing guardrails ──
    let incomplete_config = <<python -> JSON
import json

# Config with missing guardrails section
config = {"version": "1.0", "model_policies": {"gpt-4": {"allowed_uses": []}}}
required = ["model_policies", "guardrails", "version"]
missing = [r for r in required if r not in config]

naab_return(json.dumps({"missing_sections": missing, "fails_validation": len(missing) > 0}))
    >>

    if incomplete_config.fails_validation {
        print("  PASS  test_incomplete_config_fails")
        pass = pass + 1
    } else {
        print("  FAIL  test_incomplete_config_fails")
        fail = fail + 1
    }

    # ── Test 4: Model attestation required fields ──
    let attestation_check = <<python -> JSON
import json

# Good attestation
good = {"data_lineage": {"sources": ["dataset_v1"]}, "preprocessing_steps": ["normalize", "tokenize"],
        "model_version": "1.0", "training_date": "2024-01-01"}
required = ["data_lineage", "preprocessing_steps"]
good_missing = [f for f in required if f not in good]

# Bad attestation — missing required fields
bad = {"model_version": "1.0"}
bad_missing = [f for f in required if f not in bad]

naab_return(json.dumps({
    "good_passes": len(good_missing) == 0,
    "bad_fails": len(bad_missing) > 0,
    "bad_missing": bad_missing
}))
    >>

    if attestation_check.good_passes {
        print("  PASS  test_good_attestation_passes")
        pass = pass + 1
    } else {
        print("  FAIL  test_good_attestation_passes")
        fail = fail + 1
    }

    if attestation_check.bad_fails {
        print("  PASS  test_bad_attestation_fails")
        pass = pass + 1
    } else {
        print("  FAIL  test_bad_attestation_fails")
        fail = fail + 1
    }

    # ── Test 5: Rate limiting detection ──
    let rate_limit_check = <<python -> JSON
import json, re

# Code with inference endpoint but no rate limiting
code_no_limit = '''
from flask import Flask
app = Flask(__name__)

@app.post("/predict")
def predict():
    return model.predict(request.json)
'''

# Code with rate limiting
code_with_limit = '''
from flask import Flask
from flask_limiter import Limiter
app = Flask(__name__)
limiter = Limiter(app)

@app.post("/predict")
@limiter.limit("60/minute")
def predict():
    return model.predict(request.json)
'''

inference_pats = [r'@app\.(post|get)\s*\(\s*["\'].*predict']
limit_pats = [r'rate_limit', r'RateLimiter', r'limiter', r'flask_limiter']

has_inference_no_limit = (any(re.search(p, code_no_limit) for p in inference_pats) and
                          not any(re.search(p, code_no_limit, re.IGNORECASE) for p in limit_pats))

has_inference_with_limit = (any(re.search(p, code_with_limit) for p in inference_pats) and
                            any(re.search(p, code_with_limit, re.IGNORECASE) for p in limit_pats))

naab_return(json.dumps({
    "unprotected_detected": has_inference_no_limit,
    "protected_passes": has_inference_with_limit
}))
    >>

    if rate_limit_check.unprotected_detected {
        print("  PASS  test_rate_limit_unprotected_detected")
        pass = pass + 1
    } else {
        print("  FAIL  test_rate_limit_unprotected_detected")
        fail = fail + 1
    }

    if rate_limit_check.protected_passes {
        print("  PASS  test_rate_limit_protected_passes")
        pass = pass + 1
    } else {
        print("  FAIL  test_rate_limit_protected_passes")
        fail = fail + 1
    }

    # ── Test 6: Explainability detection ──
    let explain_check = <<python -> JSON
import json, re

code_with_shap = '''
import shap
explainer = shap.TreeExplainer(model)
shap_values = explainer.shap_values(X_test)
'''

code_without = '''
import sklearn
model = sklearn.ensemble.RandomForestClassifier()
model.fit(X_train, y_train)
'''

explain_pats = [r'shap\.', r'lime\.', r'eli5\.', r'feature_importance', r'Explainer\s*\(']

has_explain = any(re.search(p, code_with_shap) for p in explain_pats)
no_explain = not any(re.search(p, code_without) for p in explain_pats)

naab_return(json.dumps({"with_shap_detected": has_explain, "without_detected": no_explain}))
    >>

    if explain_check.with_shap_detected {
        print("  PASS  test_explainability_detected")
        pass = pass + 1
    } else {
        print("  FAIL  test_explainability_detected")
        fail = fail + 1
    }

    if explain_check.without_detected {
        print("  PASS  test_missing_explainability_detected")
        pass = pass + 1
    } else {
        print("  FAIL  test_missing_explainability_detected")
        fail = fail + 1
    }

    # ── Test 7: Compliance score calculation ──
    let score_check = <<python -> JSON
import json

# 4 validators, 3 pass → 75%
validators = [
    {"passed": True}, {"passed": True},
    {"passed": True}, {"passed": False}
]
total = len(validators)
passed = sum(1 for v in validators if v["passed"])
score = int((passed / total) * 100) if total > 0 else 0

naab_return(json.dumps({"score": score, "correct": score == 75}))
    >>

    if score_check.correct {
        print("  PASS  test_compliance_score_calculation — " + "" + score_check.score + "%")
        pass = pass + 1
    } else {
        print("  FAIL  test_compliance_score_calculation")
        fail = fail + 1
    }

    # ── Summary ──
    print("")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("AI Governance Tests: " + "" + pass + " PASS, " + "" + fail + " FAIL")
}
