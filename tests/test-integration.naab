# ╔══════════════════════════════════════════════════════════════════╗
# ║  NAAb BOLO — test-integration.naab                             ║
# ║  End-to-end integration tests — NAAb + Shell polyglot          ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# WHY SHELL: Integration tests run the actual CLI scripts as
#            subprocesses, capturing real stdout/stderr output.
#            This tests the full pipeline, not individual functions.
# WHY NAAB:  Orchestration, output parsing, assertion framework.

main {
    let pass = 0
    let fail = 0

    # Auto-detect naab-lang binary (submodule or system install)
    let naab = <<shell
        if [ -x ./naab/build/naab-lang ]; then
            echo -n "./naab/build/naab-lang"
        elif [ -x "$HOME/.naab/language/build/naab-lang" ]; then
            echo -n "$HOME/.naab/language/build/naab-lang"
        else
            echo -n "naab-lang"
        fi
    >>

    print("NAAb BOLO — End-to-End Integration Tests")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("  using: " + naab)

    # ── Test 1: bolo.naab shows help with no args ──
    let help_output = <<shell[naab]
        $naab bolo.naab 2>&1 || true
    >>
    if string.contains(help_output, "NAAb BOLO") {
        print("  PASS  test_bolo_help_banner")
        pass = pass + 1
    } else {
        print("  FAIL  test_bolo_help_banner")
        fail = fail + 1
    }

    if string.contains(help_output, "scan") {
        print("  PASS  test_bolo_help_commands")
        pass = pass + 1
    } else {
        print("  FAIL  test_bolo_help_commands")
        fail = fail + 1
    }

    # ── Test 2: scan.naab scans example files ──
    let scan_output = <<shell[naab]
        $naab scan.naab examples/ --profile enterprise 2>&1 || true
    >>
    if string.contains(scan_output, "NAAb BOLO Scanner") {
        print("  PASS  test_scan_runs")
        pass = pass + 1
    } else {
        print("  FAIL  test_scan_runs — missing banner")
        fail = fail + 1
    }

    if string.contains(scan_output, "Files scanned") {
        print("  PASS  test_scan_summary")
        pass = pass + 1
    } else {
        # May also show violations inline
        if string.contains(scan_output, "violations") {
            print("  PASS  test_scan_summary (found violations text)")
            pass = pass + 1
        } else {
            print("  FAIL  test_scan_summary")
            fail = fail + 1
        }
    }

    # ── Test 3: scan detects violations in bad examples ──
    let bad_scan = <<shell[naab]
        $naab scan.naab examples/bad-python.py --profile enterprise 2>&1 || true
    >>
    if string.contains(bad_scan, "violation") {
        print("  PASS  test_scan_detects_bad_python")
        pass = pass + 1
    } else {
        # May show violation lines directly
        if string.length(bad_scan) > 100 {
            print("  PASS  test_scan_detects_bad_python (output present)")
            pass = pass + 1
        } else {
            print("  FAIL  test_scan_detects_bad_python")
            fail = fail + 1
        }
    }

    # ── Test 4: scan.naab shows help with no args ──
    let scan_help = <<shell[naab]
        $naab scan.naab 2>&1 || true
    >>
    if string.contains(scan_help, "Usage") {
        print("  PASS  test_scan_help")
        pass = pass + 1
    } else {
        print("  FAIL  test_scan_help")
        fail = fail + 1
    }

    # ── Test 5: report.naab shows help with no args ──
    let report_help = <<shell[naab]
        $naab report.naab 2>&1 || true
    >>
    if string.contains(report_help, "Usage") {
        print("  PASS  test_report_help")
        pass = pass + 1
    } else {
        print("  FAIL  test_report_help")
        fail = fail + 1
    }

    # ── Test 6: enforce.naab shows help with no args ──
    let enforce_help = <<shell[naab]
        $naab enforce.naab 2>&1 || true
    >>
    if string.contains(enforce_help, "Usage") {
        print("  PASS  test_enforce_help")
        pass = pass + 1
    } else {
        print("  FAIL  test_enforce_help")
        fail = fail + 1
    }

    # ── Test 7: ai-check.naab shows help with no args ──
    let ai_help = <<shell[naab]
        $naab ai-check.naab 2>&1 || true
    >>
    if string.contains(ai_help, "Usage") {
        print("  PASS  test_ai_check_help")
        pass = pass + 1
    } else {
        print("  FAIL  test_ai_check_help")
        fail = fail + 1
    }

    # ── Test 8: bolo.naab profiles command ──
    let profiles_output = <<shell[naab]
        $naab bolo.naab profiles 2>&1 || true
    >>
    if string.contains(profiles_output, "enterprise") {
        print("  PASS  test_bolo_profiles_command")
        pass = pass + 1
    } else {
        print("  FAIL  test_bolo_profiles_command")
        fail = fail + 1
    }

    # ── Test 9: Full pipeline — scan + bolo module ──
    bolo.load_profile("enterprise")
    let code = file.read("examples/bad-python.py")
    let violations = bolo.scan("python", code)
    let vcount = array.length(violations)
    if vcount > 0 {
        print("  PASS  test_full_pipeline_bolo_scan — " + "" + vcount + " violations")
        pass = pass + 1
    } else {
        print("  FAIL  test_full_pipeline_bolo_scan — expected violations")
        fail = fail + 1
    }

    # ── Test 10: Clean code scan produces zero violations ──
    let clean_code = file.read("examples/clean-python.py")
    let clean_v = bolo.scan("python", clean_code)
    if array.length(clean_v) == 0 {
        print("  PASS  test_clean_code_zero_violations")
        pass = pass + 1
    } else {
        print("  FAIL  test_clean_code_zero_violations — got " + "" + array.length(clean_v))
        fail = fail + 1
    }

    # ── Test 11: Multiple language scanning ──
    let js_code = file.read("examples/bad-javascript.js")
    let js_v = bolo.scan("javascript", js_code)
    let sh_code = file.read("examples/bad-shell.sh")
    let sh_v = bolo.scan("shell", sh_code)
    let go_code = file.read("examples/bad-go.go")
    let go_v = bolo.scan("go", go_code)

    if array.length(js_v) > 0 {
        print("  PASS  test_multi_language — js=" + "" + array.length(js_v) + " sh=" + "" + array.length(sh_v) + " go=" + "" + array.length(go_v))
        pass = pass + 1
    } else {
        print("  FAIL  test_multi_language — expected JS violations")
        fail = fail + 1
    }

    # ── Test 12: ai-check on examples directory ──
    let ai_output = <<shell[naab]
        $naab ai-check.naab examples/ 2>&1 || true
    >>
    if string.contains(ai_output, "Compliance Score") {
        print("  PASS  test_ai_check_runs")
        pass = pass + 1
    } else {
        if string.contains(ai_output, "AI GOVERNANCE") {
            print("  PASS  test_ai_check_runs (header found)")
            pass = pass + 1
        } else {
            print("  FAIL  test_ai_check_runs")
            fail = fail + 1
        }
    }

    # ── Summary ──
    print("")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("Integration Tests: " + "" + pass + " PASS, " + "" + fail + " FAIL")
}
