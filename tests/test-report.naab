# ╔══════════════════════════════════════════════════════════════════╗
# ║  NAAb BOLO — test-report.naab                                  ║
# ║  Report format regression tests — NAAb + Python polyglot       ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# WHY PYTHON: json.loads validates JSON, xml.etree parses JUnit XML,
#             html.parser checks HTML structure. Python has the best
#             parsers for every output format we generate.
# WHY NAAB:  Test orchestration, assertion counting.

main {
    let pass = 0
    let fail = 0

    print("NAAb BOLO — Report Format Regression Tests")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    # ── Test 1: SARIF generation is valid JSON with correct structure ──
    let sarif_check = <<python -> JSON
import json

# Test data (generated internally to avoid serialization issues)
violations = [
    {"file": "test.py", "line": 5, "rule": "no_secrets", "message": "Secret found", "severity": "high", "category": "security", "level": "error"},
    {"file": "test.py", "line": 12, "rule": "sql_injection", "message": "SQL injection", "severity": "high", "category": "security", "level": "error"},
]

rules = {}
results = []
for v in violations:
    rule_id = v["rule"]
    if rule_id not in rules:
        rules[rule_id] = {"id": rule_id, "shortDescription": {"text": rule_id}}
    results.append({
        "ruleId": rule_id,
        "level": "warning",
        "message": {"text": v["message"]},
        "locations": [{"physicalLocation": {"artifactLocation": {"uri": v["file"]}}}]
    })

sarif = {
    "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
    "version": "2.1.0",
    "runs": [{"tool": {"driver": {"name": "NAAb BOLO", "rules": list(rules.values())}}, "results": results}]
}

sarif_str = json.dumps(sarif, indent=2)
# Validate by re-parsing
parsed = json.loads(sarif_str)
checks = {
    "valid_json": True,
    "has_version": parsed.get("version") == "2.1.0",
    "has_runs": "runs" in parsed,
    "has_tool": "tool" in parsed["runs"][0],
    "has_results": "results" in parsed["runs"][0],
    "result_count": len(parsed["runs"][0]["results"]),
}
naab_return(json.dumps(checks))
    >>

    if sarif_check.valid_json {
        print("  PASS  test_sarif_valid_json")
        pass = pass + 1
    } else {
        print("  FAIL  test_sarif_valid_json")
        fail = fail + 1
    }

    if sarif_check.has_version {
        print("  PASS  test_sarif_version_2_1_0")
        pass = pass + 1
    } else {
        print("  FAIL  test_sarif_version_2_1_0")
        fail = fail + 1
    }

    if sarif_check.has_runs {
        print("  PASS  test_sarif_has_runs")
        pass = pass + 1
    } else {
        print("  FAIL  test_sarif_has_runs")
        fail = fail + 1
    }

    if sarif_check.has_results {
        print("  PASS  test_sarif_has_results — " + "" + sarif_check.result_count + " results")
        pass = pass + 1
    } else {
        print("  FAIL  test_sarif_has_results")
        fail = fail + 1
    }

    # ── Test 2: HTML report has required elements ──
    let html_check = <<python -> JSON
import json, html

violations = [
    {"file": "test.py", "line": 5, "rule": "no_secrets", "message": "Secret found", "severity": "high"},
]

rows = ""
for v in violations:
    rows += f'<tr><td>{html.escape(v["file"])}</td><td>{v["line"]}</td></tr>\n'

template = f"""<!DOCTYPE html>
<html><head><title>NAAb BOLO Report</title></head>
<body><h1>NAAb BOLO Scan Report</h1>
<table><thead><tr><th>File</th><th>Line</th></tr></thead>
<tbody>{rows}</tbody></table></body></html>"""

checks = {
    "has_doctype": "<!DOCTYPE html" in template,
    "has_title": "NAAb BOLO" in template,
    "has_table": "<table>" in template,
    "has_thead": "<thead>" in template,
    "has_tbody": "<tbody>" in template,
}
naab_return(json.dumps(checks))
    >>

    if html_check.has_doctype {
        print("  PASS  test_html_has_doctype")
        pass = pass + 1
    } else {
        print("  FAIL  test_html_has_doctype")
        fail = fail + 1
    }

    if html_check.has_title {
        print("  PASS  test_html_has_title")
        pass = pass + 1
    } else {
        print("  FAIL  test_html_has_title")
        fail = fail + 1
    }

    if html_check.has_table {
        print("  PASS  test_html_has_table")
        pass = pass + 1
    } else {
        print("  FAIL  test_html_has_table")
        fail = fail + 1
    }

    # ── Test 3: CSV has correct headers ──
    let csv_check = <<python -> JSON
import json, csv, io

violations = [
    {"file": "test.py", "line": 5, "severity": "high", "rule": "no_secrets", "category": "security", "level": "error", "message": "Secret found"},
]

output = io.StringIO()
writer = csv.writer(output)
writer.writerow(["file", "line", "severity", "rule", "category", "level", "message"])
for v in violations:
    writer.writerow([v["file"], v["line"], v["severity"], v["rule"], v["category"], v["level"], v["message"]])

csv_str = output.getvalue()
lines = csv_str.strip().split("\n")
checks = {
    "has_header": "file,line,severity,rule" in lines[0],
    "has_data_rows": len(lines) > 1,
    "row_count": len(lines) - 1,
}
naab_return(json.dumps(checks))
    >>

    if csv_check.has_header {
        print("  PASS  test_csv_headers")
        pass = pass + 1
    } else {
        print("  FAIL  test_csv_headers")
        fail = fail + 1
    }

    if csv_check.has_data_rows {
        print("  PASS  test_csv_data_rows — " + "" + csv_check.row_count + " rows")
        pass = pass + 1
    } else {
        print("  FAIL  test_csv_data_rows")
        fail = fail + 1
    }

    # ── Test 4: JUnit XML is valid ──
    let junit_check = <<python -> JSON
import json, xml.etree.ElementTree as ET

violations = [
    {"file": "test.py", "rule": "no_secrets", "severity": "high", "message": "Secret found", "line": 5},
]

testsuite = ET.Element("testsuite", name="naab-bolo", tests=str(len(violations)))
for v in violations:
    tc = ET.SubElement(testsuite, "testcase", name=v["rule"], classname=v["file"])
    ET.SubElement(tc, "failure", type=v["severity"], message=v["message"])

xml_str = ET.tostring(testsuite, encoding="unicode")
checks = {
    "has_testsuite": "<testsuite" in xml_str,
    "has_testcase": "<testcase" in xml_str,
    "has_failure": "<failure" in xml_str,
    "valid_xml": True,
}

# Verify it parses back
try:
    ET.fromstring(xml_str)
except:
    checks["valid_xml"] = False

naab_return(json.dumps(checks))
    >>

    if junit_check.has_testsuite {
        print("  PASS  test_junit_has_testsuite")
        pass = pass + 1
    } else {
        print("  FAIL  test_junit_has_testsuite")
        fail = fail + 1
    }

    if junit_check.has_testcase {
        print("  PASS  test_junit_has_testcase")
        pass = pass + 1
    } else {
        print("  FAIL  test_junit_has_testcase")
        fail = fail + 1
    }

    if junit_check.valid_xml {
        print("  PASS  test_junit_valid_xml")
        pass = pass + 1
    } else {
        print("  FAIL  test_junit_valid_xml")
        fail = fail + 1
    }

    # ── Test 5: JSON report round-trips ──
    let json_check = <<python -> JSON
import json

violations = [
    {"file": "test.py", "line": 5, "rule": "no_secrets", "message": "Secret found", "severity": "high"},
]

output = {"tool": "naab-bolo", "version": "1.0.0", "total_violations": len(violations), "violations": violations}
json_str = json.dumps(output, indent=2)

# Round-trip
parsed = json.loads(json_str)
checks = {
    "tool_correct": parsed["tool"] == "naab-bolo",
    "has_violations": "violations" in parsed,
    "count_matches": parsed["total_violations"] == len(parsed["violations"]),
    "roundtrip_ok": json.loads(json.dumps(parsed)) == parsed,
}
naab_return(json.dumps(checks))
    >>

    if json_check.roundtrip_ok {
        print("  PASS  test_json_roundtrip")
        pass = pass + 1
    } else {
        print("  FAIL  test_json_roundtrip")
        fail = fail + 1
    }

    if json_check.tool_correct {
        print("  PASS  test_json_tool_field")
        pass = pass + 1
    } else {
        print("  FAIL  test_json_tool_field")
        fail = fail + 1
    }

    # ── Summary ──
    print("")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("Report Tests: " + "" + pass + " PASS, " + "" + fail + " FAIL")
}
